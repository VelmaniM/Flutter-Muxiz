# Server Configuration
PORT=5001
NODE_ENV=development
APP_URL=http://localhost:5001

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# PostgreSQL Database (Supabase Cloud PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/muxiz_music?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/muxiz_music?schema=public"

# Google Drive Storage Integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/v1/auth/google/callback
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_drive_refresh_token

# Cloudinary Backup / CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key
