{
  "name": "muxiz-server",
  "version": "1.0.0",
  "description": "Unified Backend Engine & React Studio for Muxiz Music Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:client": "cd client && npm install --include=dev && npm run build",
    "build": "npm install && npm run build:client"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^140.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "music-metadata": "^11.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
