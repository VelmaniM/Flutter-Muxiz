PORT=5001
NODE_ENV=production

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pndvh.mongodb.net/muxiz_db?retryWrites=true&w=majority

# 5TB Google Drive Media Vault
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_drive_refresh_token

# Fallback Cloudinary CDN (for dual streaming)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=muxiz_preset
