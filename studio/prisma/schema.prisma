generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  displayName      String             @map("display_name")
  avatar           String?
  authProvider     String             @default("local") @map("auth_provider")
  passwordHash     String?            @map("password_hash")
  isPremium        Boolean            @default(false) @map("is_premium")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  
  playlists        Playlist[]
  favorites        Favorite[]
  recentlyPlayed   RecentlyPlayed[]
  listeningHistory ListeningHistory[]
  downloads        DownloadRecord[]

  @@map("users")
}

model Artist {
  id          String   @id @default(uuid())
  name        String   @unique
  bio         String?
  image       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  songs       Song[]
  albums      Album[]

  @@map("artists")
}

model Album {
  id          String    @id @default(uuid())
  title       String
  artistId    String?   @map("artist_id")
  artwork     String?
  releaseDate DateTime? @map("release_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  artist      Artist?   @relation(fields: [artistId], references: [id], onDelete: SetNull)
  songs       Song[]

  @@map("albums")
}

model Song {
  id             String             @id @default(uuid())
  title          String
  artistId       String?            @map("artist_id")
  albumId        String?            @map("album_id")
  artistName     String?            @map("artist_name")
  albumName      String?            @map("album_name")
  movieName      String?            @map("movie_name")
  releaseDate    DateTime?          @map("release_date")
  duration       Int                @default(180)
  genre          String             @default("Music")
  language       String             @default("Tamil")
  
  driveFileId    String?            @map("drive_file_id")
  artworkFileId  String?            @map("artwork_file_id")
  audioUrl       String             @map("audio_url")
  artworkUrl     String?            @map("artwork_url")
  lyrics         String[]           @default([])
  gradient       String[]           @default(["#1DB954", "#0B0C10"])
  
  playCount      Int                @default(0) @map("play_count")
  status         String             @default("active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  artist         Artist?            @relation(fields: [artistId], references: [id], onDelete: SetNull)
  album          Album?             @relation(fields: [albumId], references: [id], onDelete: SetNull)
  playlistSongs  PlaylistSong[]
  favorites      Favorite[]
  recentlyPlayed RecentlyPlayed[]
  history        ListeningHistory[]
  downloads      DownloadRecord[]

  @@unique([title, artistName])
  @@index([title])
  @@index([artistName])
  @@index([movieName])
  @@index([genre])
  @@index([createdAt])
  @@index([playCount])
  @@map("songs")
}

model Playlist {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  title       String
  description String?
  cover       String?
  isPublic    Boolean        @default(true) @map("is_public")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs       PlaylistSong[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistSong {
  id         String   @id @default(uuid())
  playlistId String   @map("playlist_id")
  songId     String   @map("song_id")
  position   Int      @default(0)
  addedAt    DateTime @default(now()) @map("added_at")

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([playlistId, position])
  @@map("playlist_songs")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model RecentlyPlayed {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  playedAt  DateTime @default(now()) @map("played_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId, playedAt])
  @@map("recently_played")
}

model ListeningHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  duration  Int      @default(0)
  listenedAt DateTime @default(now()) @map("listened_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("listening_history")
}

model DownloadRecord {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  songId       String   @map("song_id")
  deviceId     String   @map("device_id")
  fileSize     Int      @default(0) @map("file_size")
  downloadedAt DateTime @default(now()) @map("downloaded_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song         Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId, deviceId])
  @@map("downloads")
}
